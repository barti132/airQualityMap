# Szablon konfiguracji dla docker compose. Skopiuj do .env (ten plik jest w .gitignore):
#   cp .env.example .env
# Nie wpisuj tu sekretów - klucze i hasła trafiają wyłącznie do prawdziwego .env / zmiennych serwera.

# Profil Springa: local (logi DEBUG) albo prod
SPRING_PROFILES_ACTIVE=local

# Port backendu na hoście
BACKEND_PORT=8080

# Limit pamięci kontenera; sterta JVM = 75% tej wartości
BACKEND_MEM_LIMIT=512m
